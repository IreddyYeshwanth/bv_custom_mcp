{
  "name": "bv-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Custom MCP server starter for Bazaarvoice",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server/index.ts",
    "report": "tsx src/cli/report.ts",
    "report:audit": "tsx src/cli/report.ts",
    "report:rr:full": "tsx src/cli/report.ts",
    "report:rr:sample": "tsx src/cli/report.ts",
    "start": "node dist/server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
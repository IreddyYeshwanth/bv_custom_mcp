# JSON array of Bazaarvoice instances this MCP server can access.
# Each entry maps to one BV client (passkey). Add more objects to the array for additional brands/locales.
#
# Fields:
#   name        - arbitrary identifier used when calling MCP tools (e.g. instanceName)
#   baseUrl     - Conversations API host (display or staging)
#   passkey     - BV client passkey (keep secret, never commit the real value)
#   apiversion  - Conversations API version (default: "5.4")
#   owner       - optional metadata label used by bv_count_instances_by_owner (e.g. "P&G")
#
# Example (Pampers en-US):
# BV_INSTANCES_JSON=[{"name":"pampers-en-us","baseUrl":"https://api.bazaarvoice.com","passkey":"YOUR_PASSKEY_HERE","apiversion":"5.4","owner":"P&G"}]
BV_INSTANCES_JSON=[]

# HTTP request timeout in milliseconds (default: 12000).
BV_TIMEOUT_MS=12000

# Displayable Content Export (DCE) API - Staging Environment
# Used for testing and development before promoting to production.
# Contact Bazaarvoice to obtain credentials.
DCE_STAGING_PASSKEY=YOUR_STAGING_PASSKEY_HERE
DCE_STAGING_SECRET=YOUR_STAGING_SECRET_HERE
DCE_STAGING_BASE_URL=https://stg.api.bazaarvoice.com

# Displayable Content Export (DCE) API - Production Environment
# Requires Technical Administrator approval in Bazaarvoice Portal.
# Uncomment and configure after approval.
# DCE_PRODUCTION_PASSKEY=YOUR_PRODUCTION_PASSKEY_HERE
# DCE_PRODUCTION_SECRET=YOUR_PRODUCTION_SECRET_HERE
# DCE_PRODUCTION_BASE_URL=https://api.bazaarvoice.com
